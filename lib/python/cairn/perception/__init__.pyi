    """
    Starting = ...
    r"""
    The session is starting.
    """
    Running = ...
    r"""
    The session is running.
    """
    Stopping = ...
    r"""
    The session is stopping.
    """
    Stopped = ...
    r"""
    The session has stopped.
    """
    Failed = ...
    r"""
    The session failed.
    """
