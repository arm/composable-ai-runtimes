{
	"name": "Rust SDK Development Container",
	"dockerComposeFile": [
		"../../services/compose.yaml",
		"docker-compose.yaml"
	],
	"service": "lib-dev",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"shutdownAction": "stopCompose",
	"runServices": [
		"lib-dev",
		"messaging-service",
		"camera-service",
		"camera-spoof-source"
	],
	"features": {
		"ghcr.io/devcontainers/features/git:1": {}
	},
	"remoteEnv": {
		"PATH": "/usr/local/cargo/bin:${containerEnv:PATH}",
		"XDG_RUNTIME_DIR": "/run/pipewire"
	},
	"postCreateCommand": "/bin/bash /workspaces/cairn-sdk/.devcontainer/lib/post-create.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"rust-lang.rust-analyzer",
				"vadimcn.vscode-lldb",
				"tamasfe.even-better-toml"
			],
			"settings": {
				"rust-analyzer.linkedProjects": [
					"/workspaces/cairn-sdk/lib/Cargo.toml"
				],
				"rust-analyzer.check.command": "clippy",
				"rust-analyzer.cargo.buildScripts.enable": true
			}
		}
	}
}
