{
	"name": "Concordia Service Development Container",
	"dockerComposeFile": "docker-compose.yaml",
	"service": "concordia-inference-service",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"shutdownAction": "stopCompose",
	"features": {
		"ghcr.io/devcontainers/features/git:1": {}
	},
	"postCreateCommand": "/bin/bash /workspaces/cairn-sdk/.devcontainer/concordia/post-create.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.debugpy"
			],
			"settings": {
				"python.defaultInterpreterPath": "/opt/venv/bin/python",
				"python.analysis.extraPaths": [
					"/workspaces/cairn-sdk/services/concordia/src",
					"/workspaces/cairn-sdk/services/concordia/src/inference/proto"
				],
				"python.testing.pytestEnabled": true,
				"python.testing.pytestArgs": [
					"services/concordia/test"
				]
			}
		}
	}
}
