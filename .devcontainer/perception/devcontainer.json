{
	"name": "Perception Service Development Container",
	"dockerComposeFile": [
		"../../services/camera/compose.yaml",
		"docker-compose.yaml"
	],
	"service": "perception-dev",
	"workspaceFolder": "/workspaces/cairn-sdk",
	"shutdownAction": "stopCompose",
	"runServices": [
		"perception-dev",
		"camera-service",
		"camera-spoof-source"
	],
	"features": {
		"ghcr.io/devcontainers/features/git:1": {}
	},
	"remoteEnv": {
		"PATH": "/workspaces/cairn-sdk/services/perception/.venv/bin:${containerEnv:PATH}",
		"PYTHONPATH": "/workspaces/cairn-sdk/services/perception/src",
		"VIRTUAL_ENV": "/workspaces/cairn-sdk/services/perception/.venv",
		"XDG_RUNTIME_DIR": "/run/pipewire"
	},
	"postCreateCommand": "/bin/bash /workspaces/cairn-sdk/.devcontainer/perception/post-create.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.debugpy",
				"charliermarsh.ruff"
			],
			"settings": {
				"python.analysis.extraPaths": [
					"/workspaces/cairn-sdk/services/perception/src"
				],
				"python.defaultInterpreterPath": "/workspaces/cairn-sdk/services/perception/.venv/bin/python",
				"python.testing.pytestEnabled": true,
				"python.testing.pytestArgs": [
					"services/perception/tests"
				],
				"[python]": {
					"editor.defaultFormatter": "charliermarsh.ruff",
					"editor.formatOnSave": true
				}
			}
		}
	}
}
